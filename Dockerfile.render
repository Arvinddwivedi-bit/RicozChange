# Single-service deploy image (Render free tier): builds the React SPA, then
# serves it from FastAPI so the whole demo lives on one URL with no CORS setup.
# Regular docker-compose deploys keep using backend/Dockerfile + frontend/Dockerfile.

# ---- Stage 1: build the frontend ----
FROM node:20-alpine AS web
WORKDIR /web
# Clerk publishable key (build-time). Empty = demo mode (no sign-in screen).
ARG VITE_CLERK_PUBLISHABLE_KEY=""
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY frontend/ .
RUN npm run build

# ---- Stage 2: Python API + static SPA ----
FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ricozchange ./ricozchange
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY --from=web /web/dist ./static

ENV AUTO_SEED=1
EXPOSE 8000

# Render routes traffic to $PORT; fall back to 8000 for local runs.
CMD ["sh", "-c", "python -m uvicorn ricozchange.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
