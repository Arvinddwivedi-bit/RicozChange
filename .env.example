[TEMPLATE]
# RicozChange configuration (all optional — defaults run the full demo)

# AI drafting (leave empty for deterministic template drafts)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Database (default: SQLite at ./data/Ricozchange.db)
# DATABASE_URL=postgresql+psycopg://user:pass@host/db

# Auth (default: demo actor priya@Ricozchange.dev)
# GATE_BY_DEMO_USER=true
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_AUDIENCE=
# CLERK_SECRET_KEY=sk_test_...   # lets the backend resolve emails from `sub`-only tokens
#
# Frontend Clerk (set VITE_CLERK_PUBLISHABLE_KEY before `npm run build`):
#   empty  -> demo mode: no sign-in, demo actor, UI says so
#   pk_... -> sign-in screen, Bearer session tokens on every /api call
# VITE_CLERK_PUBLISHABLE_KEY=

# Slack integration (phase 2, week 2)
# Create the app from slack-app-manifest.yml, then paste credentials here —
# or install via GET /api/integrations/slack/install (stores the token in the DB).
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_REDIRECT_URI=https://ricozchange-1y64.onrender.com/api/integrations/slack/oauth/callback
